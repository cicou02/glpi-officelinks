msgid "the path is outside the allowed roots"
msgstr "le chemin n'est sous aucune racine autorisée"

#: src/DocumentHooks.php:339
msgid "the path is too long"
msgstr "le chemin est trop long"

#: src/DocumentHooks.php:347
msgid "the path must designate a file, not a folder"
msgstr "le chemin doit désigner un fichier, pas un dossier"

#: src/DocumentHooks.php:344
