msgid "Host aliases"
msgstr "Alias d'hôtes"

#: hook.php:85 templates/document_field.html.twig:71
msgid "Network path"
msgstr "Chemin réseau"

#: templates/document_field.html.twig:30
msgid "Network path actions"
msgstr "Actions sur le chemin réseau"

