msgid "Network path rejected: %1$s (%2$s)"
msgstr "Chemin réseau refusé : %1$s (%2$s)"

#: templates/config.html.twig:30
msgid "No allowed root is configured: network paths cannot be saved on documents."
msgstr "Aucune racine autorisée n'est configurée : aucun chemin réseau ne peut être enregistré sur les documents."

#: front/config.form.php:59
msgid "OfficeLinks"
msgstr "OfficeLinks"

#: templates/config.html.twig:12
msgid "OfficeLinks configuration"
msgstr "Configuration d'OfficeLinks"

#: templates/config.html.twig:37
msgid "One UNC root per line. Only files located under one of these roots can be linked to a document. Matching is case-insensitive and done folder by folder."
msgstr "Une racine UNC par ligne. Seuls les fichiers situés sous l'une de ces racines peuvent être liés à un document. La comparaison ignore la casse et se fait dossier par dossier."

#: templates/config.html.twig:61
msgid "One alias per line: target server path = DFS namespace path. Paths entered with the target server are rewritten to the DFS namespace."
msgstr "Un alias par ligne : chemin du serveur cible = chemin de l'espace de noms DFS. Les chemins saisis avec le serveur cible sont réécrits vers l'espace de noms DFS."

#: templates/config.html.twig:49
msgid "One mapping per line: drive letter = UNC path. Paths entered with this drive letter are translated to the UNC path."
msgstr "Une correspondance par ligne : lettre de lecteur = chemin UNC. Les chemins saisis avec cette lettre sont traduits en chemin UNC."

#: templates/document_field.html.twig:35
msgid "Open in %s"
msgstr "Ouvrir dans %s"

#: src/DocumentHooks.php:157
msgid "Opens with %s."
msgstr "S'ouvre avec %s."

#: templates/document_field.html.twig:41
msgid "Path copied to the clipboard."
msgstr "Chemin copié dans le presse-papiers."

#: templates/document_field.html.twig:50
msgid "Show in File Explorer"
msgstr "Afficher dans l'Explorateur"

#: templates/config.html.twig:76
msgid "Show the \"Show in File Explorer\" button"
msgstr "Afficher le bouton « Afficher dans l'Explorateur »"

#: templates/config.html.twig:19
msgid "The configuration was not saved. Please fix the following lines:"
msgstr "La configuration n'a pas été enregistrée. Corrigez les lignes suivantes :"

#: src/DocumentHooks.php:156
msgid "The network path will be removed when the document is saved."
msgstr "Le chemin réseau sera supprimé à l'enregistrement du document."

#: templates/document_field.html.twig:26
msgid "The saved path is no longer allowed (%s): opening links are disabled."
msgstr "Le chemin enregistré n'est plus autorisé (%s) : les liens d'ouverture sont désactivés."

#: src/DocumentHooks.php:155
msgid "This path will be rejected:"
msgstr "Ce chemin sera refusé :"

#: templates/document_field.html.twig:19
msgid "UNC path of the file on the network share. Paste it from File Explorer (Ctrl+Shift+C). Leave empty to remove the link."
msgstr "Chemin UNC du fichier sur le partage réseau. Collez-le depuis l'Explorateur (Ctrl+Maj+C). Laissez vide pour supprimer le lien."

#: templates/document_field.html.twig:42
msgid "Unable to copy the path. Select it and press Ctrl+C."
msgstr "Impossible de copier le chemin. Sélectionnez-le puis appuyez sur Ctrl+C."

#: src/DocumentHooks.php:154
msgid "Will be saved as:"
msgstr "Sera enregistré ainsi :"

#: src/DocumentHooks.php:343
msgid "\\\\?\\ and \\\\.\\ paths are not allowed"
msgstr "les chemins \\\\?\\ et \\\\.\\ sont interdits"

#: src/DocumentHooks.php:342
msgid "a UNC path (\\\\server\\share\\...) or a mapped drive letter is expected"
msgstr "un chemin UNC (\\\\serveur\\partage\\...) ou une lettre de lecteur configurée est attendu"

#: src/PluginConfig.php:57
msgid "already defined on a previous line"
msgstr "déjà défini sur une ligne précédente"

#: src/PluginConfig.php:56
msgid "expected format: source = target"
msgstr "format attendu : source = cible"

#: src/PluginConfig.php:54
msgid "invalid UNC path (\\\\server\\share expected)"
msgstr "chemin UNC invalide (\\\\serveur\\partage attendu)"

#: src/PluginConfig.php:55
msgid "invalid drive letter (A: to Z: expected)"
msgstr "lettre de lecteur invalide (A: à Z: attendu)"

#: src/DocumentHooks.php:348
msgid "no allowed root is configured, contact your administrator"
msgstr "aucune racine autorisée n'est configurée, contactez votre administrateur"

#: src/PluginConfig.php:59
msgid "source and target are identical"
msgstr "la source et la cible sont identiques"

#: src/PluginConfig.php:58
msgid "target is not under an allowed root"
msgstr "la cible n'est sous aucune racine autorisée"

